# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next-dev.log
.next-dev.pid
.vercel-deploy.log
scripts-check_*.mjs

# env files (can opt-in for committing if needed)
.env*
!.env.example

# secrets — 絶対にコミットしない（平文APIキー等）
new-key.txt
*-key.txt
*.key
secret*.txt

# local dev config / security-e2e build artifacts
.claude/
.next-sec-e2e/

# vercel
.vercel

# local SQLite (未使用: 本番/開発とも DATABASE_URL の PostgreSQL を使用)
*.db
/dev.db
/prisma/dev.db

# python AI engine: virtualenv は requirements.txt から再構築する（コミットしない）
/api/venv/
__pycache__/
*.pyc

# scratch / 手動デバッグ用スクリプト
/test-*.js
/test-*.ts

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# 本番ミラー(dev:prod)用ビルドディレクトリ
.next-prod
