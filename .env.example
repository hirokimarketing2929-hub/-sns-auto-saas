# =============================================================================
# SNS Auto SaaS - 環境変数テンプレート
# 本ファイルをコピーして .env を作成し、各値を設定してください。
#   cp .env.example .env
# 本番(Vercel)では Project Settings > Environment Variables に同じキーを登録します。
# =============================================================================

# --- 必須: データベース (PostgreSQL) ----------------------------------------
# Prisma の datasource。Render / Supabase など任意の PostgreSQL 接続文字列。
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# --- 必須: NextAuth 認証 -----------------------------------------------------
# ランダムな十分長い文字列（例: `openssl rand -base64 32`）
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
# 本番は実ドメイン（例: https://prox-app.vercel.app）。ローカルは http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"

# --- 必須: X (Twitter) OAuth 2.0 --------------------------------------------
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

# --- 必須: AI (投稿生成) ----------------------------------------------------
# Anthropic / OpenAI いずれか。未設定だと生成系がエラー表示になる。
ANTHROPIC_API_KEY=""

# --- 必須(全環境): Cron 認可 -------------------------------------------------
# Vercel Cron / 外部cron(GitHub Actions等) から叩く際の Bearer トークン。任意のランダム文字列。
# fail-closed（RT-002 対策）: 全環境で必須。未設定だと cron は全リクエストを 401 で拒否する
#   （NODE_ENV に依存しないので preview/staging/誤デプロイでも認証ゼロにならない）。
# 生成: openssl rand -hex 32
CRON_SECRET=""

# --- セキュリティ: funnel webhook の HMAC 署名（RT-003 対策）-----------------
# プロライン→GAS→ProX の webhook を、path トークンに加えて HMAC 署名でも検証する。
# 署名秘密はサーバが PROX_ENCRYPTION_KEY と token から自動導出する（別途保存不要）。
#
# fail-safe 設計（RT-001 と一貫・env の入れ忘れで緩まない）:
#   RELEASE_MODE=mvp(β) … 既定で「署名必須」。明示的に "false" と書いたときだけ緩む。
#                          → 本番(mvp)はこの変数を入れ忘れても署名必須に倒れる（安全側）。
#   RELEASE_MODE=full(開発)… 既定で緩い。明示的に "true" のときだけ必須にできる。
# 開発(full)は既存 GAS の改修猶予のため "false" のまま。β/本番は未設定でも必須になる。
PROX_WEBHOOK_REQUIRE_SIGNATURE="false"

# --- リリース制御: 機能ゲーティング / クローズドβ ----------------------------
# RELEASE_MODE: "mvp"=本番/β（機能縮退＋BYOK必須＋招待制ゲートON） / "full"=開発(全機能)
# fail-safe（RT-001 対策）: 値が厳密に "full" のときだけ全開放。未設定・誤字・空白等は
#   すべて安全側の "mvp" に縮退する（招待ゲートON・BYOK必須・機能縮退で締まる）。
# このテンプレートの既定は安全側の "mvp"。開発者がローカルで全機能を見たいときだけ
#   自分の .env で明示的に "full" に上書きすること（事故時は締まる方向に倒れる）。
RELEASE_MODE="mvp"
# クローズドβ 招待コード（カンマ区切り）。RELEASE_MODE=mvp 時に登録で必須。
# 例: BETA_INVITE_CODES="prox-beta-001,prox-beta-002"
# mvp なのに未設定だと「全員登録不可（fail-closed）」になる点に注意。
BETA_INVITE_CODES=""

# --- BYOK（ユーザー自身のAI APIキー）フィーチャーフラグ — 決定 #032 -----------
# BYOK_ENABLED: "true"(厳密一致)=ON / それ以外=OFF（β既定・安全側）。
#   OFF（β既定）: ユーザーは AI APIキー登録不要。投稿生成は当社鍵 ANTHROPIC_API_KEY で提供。
#                  設定画面の BYOK 入力欄は非表示。濫用は下の日次上限で頭打ち。
#   ON（緊急再有効化）: 従来の「BYOK 必須」に復帰。mvp ではオーナー鍵フォールバック停止＝
#                  ユーザーは自分の AI キーが必須。設定画面に BYOK 入力欄が再表示。
#   → AIコスト暴走や Anthropic 制限など緊急時は本フラグを "true" にして即再有効化する。
BYOK_ENABLED=""
# 濫用ガード（BYOK OFF＝当社鍵提供時のみ有効）。1ユーザー当たり直近24時間の上限。
#   未設定時は保守的デフォルト（回数50 / コスト$2）。0以下・非数値も既定にフォールバック。
OWNER_KEY_DAILY_REQUEST_CAP="50"
OWNER_KEY_DAILY_COST_CAP_USD="2"

# --- フリーミアム「1日1回無料 → 自鍵」— 決定 #033 -----------------------------
# FREE_DAILY_GENERATIONS: 自鍵未設定ユーザーが当社鍵（ANTHROPIC_API_KEY）で無料生成できる
#   1日あたりの回数（暦日リセット）。既定 1。0以下・非数値は既定 1 にフォールバック。
#   超過すると AI 生成系は HTTP 402 {error:"byok_required"} を返し、フロントが BYOK 設定へ誘導する。
#   自鍵（BYOK）を登録したユーザーはこの制限の対象外＝常に自分の鍵で無制限（当社鍵を一切消費しない）。
#   判定は既存の ApiUsageLog（本日の生成行数）を流用するため、追加のスキーマは不要。
FREE_DAILY_GENERATIONS="1"

# --- 監視: Sentry (エラー監視・任意/推奨) ------------------------------------
# DSN を設定するとサーバ/クライアントの例外を捕捉して送信する。空なら監視は無効(no-op)。
# Sentry プロジェクト作成後の DSN を貼る（無料枠で可）。
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""

# --- 必須: BYOK / OAuth トークン at-rest 暗号化キー (AES-256-GCM) -------------
# X API キー・OAuth トークンを暗号化して保存するためのマスター鍵（CTO決定003 §1）。
# base64 で 32 バイト(256bit)。未設定だと暗号化系の API が fail-fast で停止する。
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 重要: 本番(Vercel 環境変数 Production)・本番ミラー(.env.prod.local)は「同じ鍵」を使うこと。
#       鍵を変えると既存の暗号化データが復号できなくなる。
PROX_ENCRYPTION_KEY=""

# --- 必須: Python AIエンジン連携 (Render の prox-agent-api) -------------------
# render.yaml でデプロイする FastAPI サービスの URL。
# リサーチ/横展開/ナレッジ解析(/api/research, /api/analyze, /api/knowledge/upload)で使用。
AI_ENGINE_URL="http://localhost:8000"

# --- マネタイズ: ProLine アフィリエイトリンク（任意・上書き用）---------------
# デフォルトでオーナーのアフィリリンク(https://q169hcpg.proline.blog)が焼き込み済みのため通常は不要。
# 別リンクに差し替えたい場合のみ設定する。
#   NEXT_PUBLIC_PROLINE_URL        ... ベースLP（ウォーム導線）
#   NEXT_PUBLIC_PROLINE_DIRECT_URL ... LINE友だち追加に直行（最終CTA。未設定時は上記 + /direct）
NEXT_PUBLIC_PROLINE_URL=""
NEXT_PUBLIC_PROLINE_DIRECT_URL=""

# --- マネタイズ: 初回オンボーディング 公式LINE導線（任意・上書き用）-----------
# 初回オンボーディングポップアップのCTA着地先 = オーナー「公式LINE」友だち追加URL（決定#027）。
# 連携ファネルの正しい受け皿: ProX登録→ポップアップ→公式LINE追加→1通目→プロライン登録。
# 直プロライン誘導ではなく公式LINEを1段挟む（owned list 資産化）。個人LINEではない点に注意。
# 未設定時は src/lib/proline.ts のデフォルト(https://q169hcpg.autosns.app/addfriend/s/cJb9d1rWoB/@303wiftq)を使用。
NEXT_PUBLIC_ONBOARDING_LINE_URL=""

# --- 任意: AIモデル指定 ------------------------------------------------------
ANTHROPIC_MODEL="claude-sonnet-4-6"
OPENAI_MODEL="gpt-4o"

# --- 任意: Supabase (ストレージ等の補助。未使用なら空でも起動可) -------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# --- 任意: 公開API URL (未設定時は NEXTAUTH_URL を使用) ----------------------
NEXT_PUBLIC_API_URL=""

# =============================================================================
# Python AIエンジン側 (api/ ディレクトリ, Render) は別途以下が必要:
#   OPENAI_API_KEY   ... AIエンジンの OpenAI 呼び出し用
# =============================================================================
